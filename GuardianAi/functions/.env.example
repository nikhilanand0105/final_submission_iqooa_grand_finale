# Saathi Personal — Threat Intelligence Secrets Configuration
# Rename to .env.local for local emulation or set via Google Cloud Secret Manager / Firebase CLI

# 1. Google Web Risk API v1 (for commercial URL reputation checks)
# Acquire key from Google Cloud Console > APIs & Services > Web Risk API
WEB_RISK_API_KEY=AIzaSyYourGoogleWebRiskApiKeyHere

# 2. VirusTotal Intelligence API v3 (for APK SHA-256 hash reputation checks)
# Acquire key from https://www.virustotal.com/gui/user/{username}/apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
