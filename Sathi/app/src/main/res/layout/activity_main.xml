<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background"
    android:fitsSystemWindows="true">

    <!-- Primary Dynamic Screens Container -->
    <FrameLayout
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_nav_bar" />

    <!-- CRED-Style Persistent Monochrome Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/nav_item_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/primary_action" />

            <TextView
                android:id="@+id/tv_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="@color/primary_action"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Scan Hub -->
        <LinearLayout
            android:id="@+id/nav_item_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_scan"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_scan"
                android:tint="@color/muted_text" />

            <TextView
                android:id="@+id/tv_nav_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Scan"
                android:textColor="@color/muted_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 3: Activity Audit -->
        <LinearLayout
            android:id="@+id/nav_item_activity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_activity"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_activity"
                android:tint="@color/muted_text" />

            <TextView
                android:id="@+id/tv_nav_activity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Activity"
                android:textColor="@color/muted_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 4: Family & Consent -->
        <LinearLayout
            android:id="@+id/nav_item_family"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_family"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_guardian"
                android:tint="@color/muted_text" />

            <TextView
                android:id="@+id/tv_nav_family"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Family"
                android:textColor="@color/muted_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 5: Settings & Senior Mode -->
        <LinearLayout
            android:id="@+id/nav_item_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_settings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/muted_text" />

            <TextView
                android:id="@+id/tv_nav_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Settings"
                android:textColor="@color/muted_text"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Contextual Assistant / Modal Container -->
    <FrameLayout
        android:id="@+id/modal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Onboarding Fullscreen Overlay Container -->
    <FrameLayout
        android:id="@+id/onboarding_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>
