rules_version = '2';
// All Saathi data is accessed only through the "api" Cloud Function (Admin SDK), which enforces
// pairing, family membership and recipient authorisation. Clients get no direct database access,
// so one family can never read or write another family's records from a device.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
