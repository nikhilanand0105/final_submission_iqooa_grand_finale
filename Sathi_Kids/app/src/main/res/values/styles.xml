<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CRED-Inspired Premium Monochrome Light Theme for iQOO 15 (144Hz LTPO, 1440x3168) -->
    <style name="Theme.Saathi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary_action</item>
        <item name="android:colorPrimaryDark">@color/primary_background</item>
        <item name="android:colorAccent">@color/restrained_accent</item>
        <item name="android:windowBackground">@color/primary_background</item>
        <item name="android:navigationBarColor">@color/main_surface</item>
        <item name="android:statusBarColor">@color/primary_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:dialogTheme">@android:style/Theme.Material.Light.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Light.Dialog.Alert</item>
    </style>
</resources>
